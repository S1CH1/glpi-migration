# GLPI Migration — Configuration
# Copier ce fichier en .env et renseigner les valeurs avant de lancer migrate.sh

# ─── Serveurs ────────────────────────────────────────────────────────────────
SOURCE_IP=""           # IP ou hostname du serveur GLPI source
TARGET_IP=""           # IP ou hostname du serveur GLPI cible
SSH_USER="adm_glpi"   # Utilisateur SSH (doit avoir sudo sur les deux machines)

# ─── Base de données ──────────────────────────────────────────────────────────
DB_NAME="glpi_prod"
DB_USER="adm_glpi"
DB_PASS=""             # Mot de passe MariaDB de l'utilisateur GLPI

# ─── NAS Synology (NFS) ───────────────────────────────────────────────────────
NAS_IP=""              # IP du NAS Synology
NAS_SHARE="/volume1/GLPI-PROD_NFS"   # Chemin du partage NFS sur le NAS
NFS_MOUNT="/mnt/glpi-syno-data"      # Point de montage local sur la cible

# ─── GLPI ─────────────────────────────────────────────────────────────────────
GLPI_VERSION="11.0.4"
GLPI_WEB_DIR="/var/www/glpi"
GLPI_DATA_DIR="/var/lib/glpi"
GLPI_ETC_DIR="/etc/glpi"
GLPI_LOG_DIR="/var/log/glpi"
